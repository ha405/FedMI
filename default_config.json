{
    "_comment": "Default config. Override any field via CLI: python main.py --dataset CIFAR10 --model ResNet --partition dirichlet --alpha 0.3",

    "device": "cuda",
    "seed": 42,
    "output_dir": "./results/experiment_run",

    "dataset_name": "MNIST",
    "data_root": "./data",
    "batch_size": 256,
    "num_workers": 0,

    "model_name": "SimpleCNN",
    "conv_channels": [32, 64, 128],
    "num_classes": 10,

    "num_clients": 5,
    "num_rounds": 100,
    "local_epochs": 5,

    "partition_method": "iid",
    "dirichlet_alpha": 0.5,

    "train_mode": "sparse",
    "learning_rate": 0.001,

    "target_sparsity": 0.99,
    "gate_lr": 0.1,
    "l0_lambda": 0.01,
    "discovery_steps": 200,

    "_comment_classes": "null = auto-derived from partition at runtime (recommended).",
    "classes_to_analyze": null,
    "classes_to_discover_per_client": null,

    "use_mean_ablation": false,

    "use_fedrs": false,
    "fedrs_alpha": 0.4,

    "resume": false
}